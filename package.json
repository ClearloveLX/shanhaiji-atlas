{
  "name": "shanhaiji-atlas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClearloveLX/shanhaiji-atlas.git"
  },
  "description": "山海集 Atlas —— 可持续维护的生活导航站（工具 / 站点 / 好店，按多维度标签组织）",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio --port 4001",
    "db:reset": "tsx src/db/reset.ts",
    "backup": "bash scripts/backup.sh",
    "check-links": "tsx scripts/link-check.ts",
    "sort:normalize": "tsx scripts/normalize-sort-weight.ts",
    "icons:fetch": "tsx scripts/fetch-icons.ts",
    "test:privacy": "tsx tests/privacy.test.ts",
    "test:svg": "tsx tests/svg-sanitize.test.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@hookform/resolvers": "^5.9.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.56.0",
    "nanoid": "^6.0.2",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
