# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files（.env.example 要提交，本地实际配置不提交）
.env*
!.env.example

# 运行时数据：数据库、上传的图片、备份 —— 永不随部署覆盖
/data/

# 发布暂存目录（deploy.py 每次重建）—— 不进仓库，也不参与 typecheck
/dist-deploy/
/dist-deploy.tar.gz

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
