# ── 数据库（SQLite，不是 DATABASE_URL） ──
DATABASE_PATH=./data/atlas.db

# ── 上传目录（运行时数据，永不随部署覆盖） ──
UPLOAD_DIR=./data/uploads

# ── 认证 ──
# 生成方式：openssl rand -base64 32
AUTH_SECRET=
ADMIN_EMAIL=admin@example.com
# 明文只用于首次 seed，seed 时 bcrypt 哈希后写库
ADMIN_PASSWORD=

# ── 站点 ──
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# ── 定时任务鉴权（/api/cron/*），随便一串随机字符 ──
CRON_TOKEN=

# ── 高德地图（可选） ──
# 申请方式：高德开放平台 → 应用管理 → 我的应用 → 添加 Key → 服务平台选「Web 服务」
# 不填则地理编码降级为手工填写经纬度，功能不报错
AMAP_KEY=
# 好店地图页要用的是「Web 端 (JS API)」的 key，和上面那个不是同一个，需要单独申请
NEXT_PUBLIC_AMAP_JS_KEY=

TZ=Asia/Shanghai
